00%;\r\n            padding: 22px 24px;\r\n        }\r\n\r\n        .footer-col {\r\n            min-width: calc(50% - 10px);\r\n        }\r\n    }\r\n\r\n    @media (max-width: 480px) {\r\n        .login-section {\r\n            padding: 8px 10px;\r\n        }\r\n\r\n        .footer-col {\r\n            min-width: 100%;\r\n        }\r\n    }\r\n\r\n    /* hide old styles */\r\n    .main-box, .slider-cont, .form-cont, .signup-slider {\r\n        display: none !important;\r\n    }\r\n</style>\r\n\r\n<!-- Navbar -->\r\n<nav class=\"top-nav\">\r\n    <a class=\"brand\" href=\"https://pulsedigitalclinic.com/home\" target=\"_blank\">\r\n        <img src=\"/Content/images/Pulse-logo.png\" alt=\"Pulse Digital\">\r\n    </a>\r\n    <button class=\"nav-toggle\" onclick=\"document.getElementById('mainNav').classList.toggle('open')\">&#9776;</button>\r\n    <div class=\"nav-links\" id=\"mainNav\">\r\n        <a href=\"https://pulsedigitalclinic.com/home\" target=\"_blank\">Home</a>\r\n        <a href=\"https://pulsedigitalclinic.com/about\" target=\"_blank\">About</a>\r\n        <a href=\"https://pulsedigitalclinic.com/data-security\" target=\"_blank\">Data Security</a>\r\n        <a href=\"https://pulsedigitalclinic.com/services\" target=\"_blank\">Services</a>\r\n        <a href=\"https://pulsedigitalclinic.com/dental\" target=\"_blank\">Plans</a>\r\n    </div>\r\n</nav>\r\n\r\n<!-- Login -->\r\n<div class=\"login-section\">\r\n    <div class=\"login-box\">\r\n\r\n        <div class=\"login-left\">\r\n            <img src=\"/Content/images/Pulse-logo.png\" class=\"logo\" alt=\"Pulse Digital\" />\r\n            <h2>Welcome Back</h2>\r\n            <p>Please <strong>Sign In</strong> to continue</p>\r\n        </div>\r\n\r\n        <div class=\"login-right\">\r\n<form action=\"/account/login\" method=\"post\"><input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"q5NlyfKe5mjjAlD91SKzc7ehQi_LCceSWk2-5l1CXalMyCYdqtXnbAXFsH3nXQy_KxDWBbJNv6erp3RcSLKzqFXReqFbpL2wSM4mASQK