device-pixel-ratio: 2)\" href=\"/apple-launch-640x1136.png\">\r\n    <!-- iPad Mini, Air (1536px x 2048px) -->\r\n    <link rel=\"apple-touch-startup-image\" media=\"(device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2)\" href=\"/apple-launch-1536x2048.png\">\r\n    <!-- iPad Pro 10.5\" (1668px x 2224px) -->\r\n    <link rel=\"apple-touch-startup-image\" media=\"(device-width: 834px) and (device-height: 1112px) and (-webkit-device-pixel-ratio: 2)\" href=\"/apple-launch-1668x2224.png\">\r\n    <!-- iPad Pro 12.9\" (2048px x 2732px) -->\r\n    <link rel=\"apple-touch-startup-image\" media=\"(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)\" href=\"/apple-launch-2048x2732.png\">\r\n\r\n\r\n    <!--End-->\r\n\r\n\r\n\r\n    <script>\r\n        $.material.init();\r\n    </script>\r\n\r\n    \r\n\r\n    <style>\r\n        @media all and (display-mode: standalone) {\r\n            body {\r\n                background-color: yellow;\r\n            }\r\n        }\r\n        /*.add-button {\r\n            position: absolute;\r\n            top: 1px;\r\n            left: 1px;\r\n        }*/\r\n    </style>\r\n\r\n</head>\r\n<body class=\"pattern\">\r\n\r\n    <div class=\"container-fluid\">\r\n        <div class=\"row-fluid\">\r\n\r\n\r\n            <!--/span-->\r\n            \r\n\r\n\r\n\r\n\r\n\r\n<style>\r\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap');\r\n\r\n    *, *::before, *::after {\r\n        box-sizing: border-box;\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    html, body {\r\n        height: 100% !important;\r\n        overflow: hidden !important;\r\n        background: url('../Content/images/background.png') center center / cover no-repeat fixed !important;\r\n    }\r\n\r\n    body {\r\n        font-family: 'Montserrat', sans-serif;\r\n        display: flex;\r\n        flex-direction: column;\r\n        min-height: 100vh !important;\r\n    }\r\n\r\n        /* Full page wrapper to guarantee gradient covers everything */\r\n        body::after {\r\n            content: '';\r\n            display: block;\r\n            position: fixed;\r\n            top: 0;\r\n            left: 0;\r\n            right: 0;\r\n            bottom: 0;\r\n            background: url('../Content/images/background.png') center center / cover no-repeat;\r\n            z-index: -1;\r\n        }\r\n\r\n    /* ─── NAVBAR ─────────────────────────────── */\r\n    .top-nav {\r\n        height: 52px;\r\n        background: #fff;\r\n        border-bottom: 1px solid #e0e0e0;\r\n        display: flex;\r\n        align-items: center;\r\n        padding: 0 20px;\r\n        gap: 12px;\r\n        flex-shrink: 0;\r\n        position: relative;\r\n        z-index: 100;\r\n    }\r\n\r\n        .top-nav .brand img {\r\n            height: 34px;\r\n            display: block;\r\n        }\r\n\r\n        .top-nav .nav-links {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 4px;\r\n            margin-left: auto;\r\n        }\r\n\r\n            .top-nav .nav-links a {\r\n                font-size: 12px;\r\n                font-weight: 500;\r\n                color: #555;\r\n                text-decoration: none;\r\n                padding: 5px 10px;\r\n                border-radius: 5px;\r\n                transition: color .2s, background .2s;\r\n            }\r\n\r\n                .top-nav .nav-links a:hover {\r\n                    color: #512da8;\r\n                    background: #f3f0fc;\r\n                }\r\n\r\n    .nav-toggle {\r\n        display: none;\r\n        background: none;\r\n        border: 1px solid #ccc;\r\n        border-radius: 5px;\r\n        padding: 4px 9px;\r\n        cursor: pointer;\r\n        font-size: 16px;\r\n        color: #444;\r\n        margin-left: auto;\r\n    }\r\n\r\n    .nav-links.open {\r\n        display: flex !important;\r\n        flex-direction: column;\r\n        position: absolute;\r\n        top: 52px;\r\n        left: 0;\r\n        right: 0;\r\n        background: #fff;\r\n        border-bottom: 1px solid #e0e0e0;\r\n        padding: 10px 16px;\r\n        gap: 4px;\r\n        z-index: 999;\r\n    }\r\n\r\n    /* ─── LOGIN SECTION ──────────────────────── */\r\n    .login-section {\r\n        flex: 1 0 auto;\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        padding: 20px 16px;\r\n        min-height: calc(100vh - 52px - 120px);\r\n    }\r\n\r\n    .login-box {\r\n        display: flex;\r\n        width: 680px;\r\n        max-width: 100%;\r\n        border-radius: 16px;\r\n        overflow: hidden;\r\n        box-shadow: 0 10px 40px rgba(0,0,0,0.16);\r\n        background: #fff;\r\n    }\r\n\r\n    /* Left panel */\r\n    .login-left {\r\n        width: 42%;\r\n        background: linear-gradient(160deg, #512da8, #5dbdb9);\r\n        color: #fff;\r\n        display: flex;\r\n        flex-direction: column;\r\n        align-items: center;\r\n        justify-content: center;\r\n        padding: 24px 20px;\r\n        text-align: center;\r\n        flex-shrink: 0;\r\n    }\r\n\r\n        .login-left .logo {\r\n            height: 42px;\r\n            margin-bottom: 14px;\r\n            filter: brightness(0) invert(1);\r\n        }\r\n\r\n        .login-left h2 {\r\n            font-size: 18px;\r\n            font-weight: 600;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .login-left p {\r\n            font-size: 12px;\r\n            opacity: .9;\r\n            line-height: 1.5;\r\n        }\r\n\r\n    /* Right panel */\r\n    .login-right {\r\n        width: 58%;\r\n        padding: 28px 32px;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: center;\r\n    }\r\n\r\n        .login-right h1 {\r\n            font-size: 20px;\r\n            font-weight: 600;\r\n            margin-bottom: 18px;\r\n            color: #222;\r\n        }\r\n\r\n    .form-group {\r\n        margin-bottom: 12px;\r\n    }\r\n\r\n        .form-group label {\r\n            display: block;\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n            color: #444;\r\n            margin-bottom: 4px;\r\n        }\r\n\r\n    .form-control {\r\n        width: 100%;\r\n        padding: 9px 12px;\r\n        border-radius: 7px;\r\n        border: none;\r\n        background: #eee;\r\n        font-size: 13px;\r\n        outline: none;\r\n        color: #333;\r\n        font-family: 'Montserrat', sans-serif;\r\n        transition: background .2s;\r\n    }\r\n\r\n        .form-control:focus {\r\n            background: #e0e0f0;\r\n        }\r\n\r\n    .forgot-link {\r\n        text-align: right;\r\n        margin: 6px 0 14px;\r\n    }\r\n\r\n        .forgot-link a {\r\n            font-size: 12px;\r\n            color: #512da8;\r\n            text-decoration: none;\r\n            font-weight: 500;\r\n        }\r\n\r\n            .forgot-link a:hover {\r\n                text-decoration: underline;\r\n            }\r\n\r\n    .btn-login {\r\n        width: 100%;\r\n        padding: 10px;\r\n        background: #512da8;\r\n        border: none;\r\n        border-radius: 8px;\r\n        color: #fff;\r\n        font-weight: 600;\r\n        font-size: 14px;\r\n        cursor: pointer;\r\n        font-family: 'Montserrat', sans-serif;\r\n        transition: background .25s;\r\n    }\r\n\r\n        .btn-login:hover {\r\n            background: #3f2b96;\r\n        }\r\n\r\n    /* Validation */\r\n    .text-danger {\r\n        color: #c0392b;\r\n        font-size: 11px;\r\n        margin-top: 3px;\r\n        display: block;\r\n    }\r\n\r\n    div.validation-summary-errors ul {\r\n        list-style: none;\r\n        padding: 0;\r\n        font-size: 12px;\r\n        color: #c0392b;\r\n        text-align: center;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    /* ─── FOOTER ─────────────